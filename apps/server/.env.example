# Port du serveur
PORT=5000

# Connexion PostgreSQL (identifiants du service local dans infra/docker-compose.yml)
DATABASE_URL=postgresql://scene404:scene404@localhost:5433/scene404?schema=public

# Secret pour signer les JWT (chaîne longue et aléatoire)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# URL du front (pour CORS)
CLIENT_URL=http://localhost:5173
